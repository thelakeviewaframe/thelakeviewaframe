# Copy this file to .env.local for local dev, and add the same values in
# Vercel > Project > Settings > Environment Variables for production.

# --- Supabase (free tier) ---
# Create a project at https://supabase.com, then Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (https://dashboard.stripe.com) ---
# Use the test keys (start with sk_test_ / pk_test_) until you're ready to go live
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- Resend (https://resend.com) -- sends the approve/decline request email ---
RESEND_API_KEY=re_xxxxxxxx
# Leave unset to use Resend's shared test sender (only delivers to the email
# you signed up with). Set this once you've verified your own domain in Resend.
RESEND_FROM_EMAIL=bookings@yourdomain.com
# Where new booking requests get emailed for you to approve/decline
HOST_EMAIL=you@example.com

# --- Your OTA calendar feeds ---
# Airbnb: Listing > Availability > Sync calendars > "Export calendar" (copy the URL)
# VRBO/Vrbo: Listing > Calendar > Import/Export calendars > "Export" (copy the URL)
AIRBNB_ICAL_URL=https://www.airbnb.com/calendar/ical/XXXXXXX.ics?s=XXXXXXXX
VRBO_ICAL_URL=https://www.vrbo.com/icalendar/XXXXXXX.ics

# --- Site basics ---
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
NEXT_PUBLIC_PROPERTY_NAME="Lakeview A-Frame"
NIGHTLY_RATE_USD=350
CLEANING_FEE_USD=150
DEPOSIT_PERCENT=25
# Shared secret so only Vercel Cron (or you) can trigger the iCal sync endpoint
CRON_SECRET=choose-a-random-string
